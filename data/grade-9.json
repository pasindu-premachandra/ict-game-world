          "name": {
            "en": "Count and Sort",
            "si": "ගණන් කිරීම හා වර්ග කිරීම"
          },
          "instruction": {
            "en": "Type the correct spreadsheet function for each task.",
            "si": "එක් එක් කාර්යය සඳහා නිවැරදි පැතුරුම්පත්ශ්‍රිතය ටයිප් කරන්න."
          },
          "questions": [
            {
              "q": {
                "en": "To count how many cells from A1 to A20 hold a number:",
                "si": "A1 සිට A20 දක්වා සංඛ්‍යාවක් ඇති කොටු කීයක් ඇත්දැයි ගණන් කිරීමට:"
              },
              "ans": "=count(a1:a20)",
              "hint": {
                "en": "COUNT counts only numbers",
                "si": "COUNT මඟින් ගණන් කරන්නේ සංඛ්‍යා පමණි"
              }
            },
            {
              "q": {
                "en": "To count how many cells from B1 to B20 are not empty:",
                "si": "B1 සිට B20 දක්වා හිස් නොවන කොටු කීයක් ඇත්දැයි ගණන් කිරීමට:"
              },
              "ans": "=counta(b1:b20)",
              "hint": {
                "en": "COUNTA counts text as well as numbers",
                "si": "COUNTA මඟින් සංඛ්‍යා මෙන්ම පාඨද ගණන් කරයි"
              }
            },
            {
              "q": {
                "en": "To add up the marks in C2 to C41:",
                "si": "C2 සිට C41 දක්වා ලකුණු එකතු කිරීමට:"
              },
              "ans": "=sum(c2:c41)",
              "hint": {
                "en": "Use the SUM function",
                "si": "SUM ශ්‍රිතය භාවිත කරන්න"
              }
            },
            {
              "q": {
                "en": "To find the class average of D2 to D41:",
                "si": "D2 සිට D41 දක්වා පන්තියේ සාමාන්‍යය සෙවීමට:"
              },
              "ans": "=average(d2:d41)",
              "hint": {
                "en": "Use the AVERAGE function",
                "si": "AVERAGE ශ්‍රිතය භාවිත කරන්න"
              }
            }
          ],
          "origin": "syllabus-enrichment",
